{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/login/index",
			"style": {
				"navigationBarTitleText": "登录",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/login/select-customer",
			"style": {
				"navigationBarTitleText": "选择客户"
			}
		},
		{
			"path": "pages/login/select-merchant",
			"style": {
				"navigationBarTitleText": "选择商户"
			}
		},
		{
			"path": "pages/register/customer",
			"style": {
				"navigationBarTitleText": "客户注册"
			}
		},
		{
			"path": "pages/register/bind-merchant",
			"style": {
				"navigationBarTitleText": "绑定商户"
			}
		},
		{
			"path": "pages/register/merchant",
			"style": {
				"navigationBarTitleText": "商户注册"
			}
		},
		{
			"path": "pages/home/index",
			"style": {
				"navigationBarTitleText": "首页"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "Core Ledger",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"uniIdRouter": {}
}